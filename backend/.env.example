# Copy this file to .env and fill in your Gemini key.
# On Windows PowerShell, you can also set the variable temporarily via:
#   $env:GEMINI_API_KEY = "your_api_key_here"
# Then start the backend from the same shell so it inherits the env var.

# Primary key expected by the backend
GEMINI_API_KEY=

# Alternate variable name supported for convenience
# GOOGLE_API_KEY=

# Optional provider toggles
# USE_EXTERNAL_APIS=true
# NAME_PROVIDER=datamuse
# LOGO_PROVIDER=dicebear
